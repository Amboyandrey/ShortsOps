# User service: install with `systemctl --user enable --now shortsops-agent` (see README).
[Unit]
Description=ShortsOps agent for the facts-shorts pipeline
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Documents/GitHub/ShortsOps/agent
EnvironmentFile=%h/Documents/GitHub/ShortsOps/agent/.env
ExecStart=%h/Documents/GitHub/ShortsOps/agent/.venv/bin/shortsops-agent
Restart=always
RestartSec=15
# No sandboxing options: in a user service they need a user namespace, which disables the setgid
# crontab binary the heartbeat uses to confirm the cron job is installed.

[Install]
WantedBy=default.target
