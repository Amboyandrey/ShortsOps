# Copy to agent/.env (chmod 600). Never commit the real file.
# Project URL and publishable key: Supabase dashboard > Project Settings > API Keys.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# The dedicated agent user (app_metadata.role = "agent"); see README "Create the two users".
AGENT_EMAIL=agent@example.com
AGENT_PASSWORD=
# The facts-shorts checkout this agent controls.
PIPELINE_DIR=~/facts-shorts
